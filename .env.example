# PostgreSQL connection used by the application and migrations.
# Inside Docker Compose the host is `db`; on the host machine it is `localhost`.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/shopping_assistant

# Port the web app binds to when running outside Docker.
PORT=3000

# Load the labelled development-fixture catalogue rows after migrations.
# Keep disabled outside local development; fixtures are separate from live data.
LOAD_DEV_FIXTURES=true

# One-time installation setup token held by the operator, not the database.
# Open /setup once with it to create the first administrator and private
# workspace; the claim then stops working. Generate one with:
#   openssl rand -base64 32
# Remove it after setup so it cannot be reused.
SETUP_TOKEN=

# Signs session cookies and identity tokens. Generate one with:
#   openssl rand -base64 32
# Changing it signs every user out.
BETTER_AUTH_SECRET=

# Encrypts stored credentials at rest, such as the SMTP password. Held by the
# operator outside PostgreSQL, so a database dump alone reveals nothing. At
# least 16 characters; generate one with:
#   openssl rand -base64 32
# Changing it makes stored credentials unreadable: they must be entered again.
INSTALLATION_SECRET=

# Public origin of the web app; must match the URL users open.
BETTER_AUTH_URL=http://localhost:3000

# Encrypts provider credentials (AI model API keys) at rest. It is held outside
# PostgreSQL, so a database dump alone never reveals a key. Generate one with:
#   openssl rand -base64 32
# Changing it makes stored provider keys unreadable; re-enter them in settings.
INSTALLATION_SECRET=

# Live provider smoke checks are opt-in and never run in CI. Supply real
# credentials only on a machine you are willing to spend a few tokens from:
#   LIVE_OPENAI_API_KEY=..., LIVE_OPENAI_MODEL=gpt-5-mini
#   LIVE_ANTHROPIC_API_KEY=..., LIVE_ANTHROPIC_MODEL=claude-sonnet-4-5
#   LIVE_COMPATIBLE_API_KEY=..., LIVE_COMPATIBLE_BASE_URL=http://host:11434/v1

